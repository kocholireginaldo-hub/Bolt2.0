# Copie para ".env" (que NÃO deve ir para o GitHub) ou defina no painel do seu provedor de hospedagem.
# Nenhum destes valores é lido pelo navegador: ficam somente no servidor (server.js).

# --- Servidor ---
PORT=8787
# 127.0.0.1 = só este computador. Use 0.0.0.0 para acessar do celular na mesma rede
# (nesse caso defina BRIDGE_TOKEN para manter a ponte Wi-Fi OBD2 ligada).
HOST=127.0.0.1

# --- Assistente com IA (opcional) ---
# anthropic  -> API da Anthropic (modelo padrão: claude-haiku-5-5)
# openai     -> qualquer API compatível com /chat/completions (defina AI_MODEL e, se preciso, AI_BASE_URL)
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_RATE_LIMIT_PER_MIN=20

# --- CORS (somente se o app estático ficar em outro domínio, ex.: GitHub Pages) ---
# Lista separada por vírgulas. Exemplo: https://seuusuario.github.io
ALLOWED_ORIGINS=

# --- Ponte Wi-Fi OBD2 ---
# 0 desliga a ponte. Em HOST diferente de localhost a ponte só liga com token.
ENABLE_WIFI_BRIDGE=1
BRIDGE_TOKEN=
